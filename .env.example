# Postgres on Railway, e.g. postgresql://user:pass@host:port/dbname
# Falls back to local sqlite:///./patients.db if unset (fine for local dev/tests).
DATABASE_URL=

# Shared secret Vapi sends as the x-vapi-secret header on every webhook call.
# Set the same value in the Vapi assistant's server config.
VAPI_WEBHOOK_SECRET=
