{
  "name": "Ava - Patient Intake",
  "firstMessage": "Hi, thanks for calling! I'm Ava, and I can help you get registered as a new patient. Can I start with the phone number you'd like on file?",
  "model": {
    "provider": "openai",
    "model": "gpt-4o",
    "temperature": 0.4,
    "systemPrompt": "<paste contents of prompts/system_prompt.md code block here>",
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "lookup_patient",
          "description": "Look up an existing patient by phone number to detect a returning caller before registering a new record.",
          "parameters": {
            "type": "object",
            "properties": {
              "phone_number": { "type": "string", "description": "10-digit US phone number" }
            },
            "required": ["phone_number"]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "register_patient",
          "description": "Create a new patient record after the caller has confirmed all collected information.",
          "parameters": {
            "type": "object",
            "properties": {
              "first_name": { "type": "string" },
              "last_name": { "type": "string" },
              "date_of_birth": { "type": "string", "description": "YYYY-MM-DD" },
              "sex": { "type": "string", "enum": ["Male", "Female", "Other", "Decline to Answer"] },
              "phone_number": { "type": "string" },
              "email": { "type": "string" },
              "address_line_1": { "type": "string" },
              "address_line_2": { "type": "string" },
              "city": { "type": "string" },
              "state": { "type": "string", "description": "2-letter US state abbreviation" },
              "zip_code": { "type": "string" },
              "insurance_provider": { "type": "string" },
              "insurance_member_id": { "type": "string" },
              "preferred_language": { "type": "string" },
              "emergency_contact_name": { "type": "string" },
              "emergency_contact_phone": { "type": "string" }
            },
            "required": [
              "first_name", "last_name", "date_of_birth", "sex",
              "phone_number", "address_line_1", "city", "state", "zip_code"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "update_patient",
          "description": "Update fields on an existing patient record found via lookup_patient.",
          "parameters": {
            "type": "object",
            "properties": {
              "patient_id": { "type": "string" },
              "first_name": { "type": "string" },
              "last_name": { "type": "string" },
              "date_of_birth": { "type": "string" },
              "sex": { "type": "string", "enum": ["Male", "Female", "Other", "Decline to Answer"] },
              "phone_number": { "type": "string" },
              "email": { "type": "string" },
              "address_line_1": { "type": "string" },
              "address_line_2": { "type": "string" },
              "city": { "type": "string" },
              "state": { "type": "string" },
              "zip_code": { "type": "string" },
              "insurance_provider": { "type": "string" },
              "insurance_member_id": { "type": "string" },
              "preferred_language": { "type": "string" },
              "emergency_contact_name": { "type": "string" },
              "emergency_contact_phone": { "type": "string" }
            },
            "required": ["patient_id"]
          }
        }
      },
      {
        "type": "endCall",
        "function": {
          "name": "end_call",
          "description": "End the phone call. Use after the patient's registration or update has been saved successfully, when the caller says goodbye or that they're done, when they ask for something this line can't handle, after two failed save attempts, or after two unanswered re-prompts. Always speak a short closing line before calling this. Never call it while a field is still being collected."
        },
        "messages": [
          {
            "type": "request-start",
            "content": "You're all set. Thanks for calling, take care!"
          }
        ]
      }
    ]
  },
  "voice": {
    "provider": "11labs",
    "voiceId": "rachel",
    "stability": 0.45,
    "similarityBoost": 0.75,
    "style": 0.1,
    "useSpeakerBoost": true,
    "speed": 0.95
  },
  "startSpeakingPlan": {
    "waitSeconds": 0.6,
    "smartEndpointingEnabled": true,
    "transcriptionEndpointingPlan": {
      "onPunctuationSeconds": 0.2,
      "onNoPunctuationSeconds": 1.4,
      "onNumberSeconds": 1.2
    }
  },
  "stopSpeakingPlan": {
    "numWords": 2,
    "voiceSeconds": 0.3,
    "backoffSeconds": 1.5
  },
  "transcriber": {
    "provider": "deepgram",
    "model": "nova-3",
    "language": "en-US",
    "smartFormat": true,
    "keyterm": ["Doe", "Jane", "Bovat"]
  },
  "serverUrl": "https://<your-railway-app>.up.railway.app/vapi/webhook",
  "serverUrlSecret": "<same value as VAPI_WEBHOOK_SECRET>",
  "backgroundDenoisingEnabled": true,
  "silenceTimeoutSeconds": 90,
  "messagePlan": {
    "idleMessages": [
      "Take your time, I'm still here.",
      "Are you still there?",
      "I'll stay on the line a moment longer in case we got disconnected."
    ],
    "idleTimeoutSeconds": 20,
    "idleMessageMaxSpokenCount": 3
  }
}
